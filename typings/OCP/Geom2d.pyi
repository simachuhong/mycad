from .gp import gp_Ax2d, gp_Pnt2d
from .TColgp import TColgp_Array1OfPnt2d
from .TColStd import TColStd_Array1OfInteger, TColStd_Array1OfReal

class Geom2d_Curve:
    def Value(self, parameter: float) -> gp_Pnt2d: ...

class Geom2d_Ellipse(Geom2d_Curve):
    def __init__(self, axis: gp_Ax2d, major: float, minor: float) -> None: ...

class Geom2d_Circle(Geom2d_Curve):
    def __init__(self, axis: gp_Ax2d, radius: float) -> None: ...

class Geom2d_BSplineCurve(Geom2d_Curve):
    def __init__(
        self,
        poles: TColgp_Array1OfPnt2d,
        weights: TColStd_Array1OfReal,
        knots: TColStd_Array1OfReal,
        multiplicities: TColStd_Array1OfInteger,
        degree: int,
        periodic: bool = False,
    ) -> None: ...
    def FirstParameter(self) -> float: ...
    def LastParameter(self) -> float: ...
    def Segment(self, first: float, last: float, tolerance: float = ...) -> None: ...
    def NbPoles(self) -> int: ...
    def NbKnots(self) -> int: ...
    def Pole(self, index: int) -> gp_Pnt2d: ...
    def Weight(self, index: int) -> float: ...
    def Knot(self, index: int) -> float: ...
    def Multiplicity(self, index: int) -> int: ...
    def Degree(self) -> int: ...
    def IsPeriodic(self) -> bool: ...
