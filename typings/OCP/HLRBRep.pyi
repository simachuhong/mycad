from .HLRAlgo import HLRAlgo_Projector
from .TopoDS import TopoDS_Shape

class _ShapeMap:
    def Extent(self) -> int: ...
    def FindKey(self, index: int) -> TopoDS_Shape: ...

class _Data:
    def FaceMap(self) -> _ShapeMap: ...

class _History:
    def NewSOldS(self, shape: TopoDS_Shape) -> TopoDS_Shape: ...

class _Outliner:
    def DataStructure(self) -> _History: ...

class _Bounds:
    def Shape(self) -> _Outliner: ...

class HLRBRep_Algo:
    def __init__(self) -> None: ...
    def Add(self, shape: TopoDS_Shape) -> None: ...
    def Projector(self, projector: HLRAlgo_Projector) -> None: ...
    def Update(self) -> None: ...
    def Hide(self) -> None: ...
    def DataStructure(self) -> _Data: ...
    def ShapeBounds(self, index: int) -> _Bounds: ...

class HLRBRep_HLRToShape:
    def __init__(self, algo: HLRBRep_Algo) -> None: ...
    def VCompound(self, shape: TopoDS_Shape = ...) -> TopoDS_Shape: ...
    def HCompound(self, shape: TopoDS_Shape = ...) -> TopoDS_Shape: ...
    def Rg1LineVCompound(self, shape: TopoDS_Shape = ...) -> TopoDS_Shape: ...
    def OutLineVCompound(self, shape: TopoDS_Shape = ...) -> TopoDS_Shape: ...
    def OutLineHCompound(self, shape: TopoDS_Shape = ...) -> TopoDS_Shape: ...
