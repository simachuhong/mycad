"""Subset of OCCT 7.9.3 signatures exercised by the engineering drawing probe."""

class TopoDS_Shape:
    def IsNull(self) -> bool: ...
    def IsSame(self, other: TopoDS_Shape) -> bool: ...

class TopoDS_Compound(TopoDS_Shape): ...
class TopoDS_CompSolid(TopoDS_Shape): ...
class TopoDS_Solid(TopoDS_Shape): ...
class TopoDS_Shell(TopoDS_Shape): ...
class TopoDS_Face(TopoDS_Shape): ...
class TopoDS_Wire(TopoDS_Shape): ...
class TopoDS_Edge(TopoDS_Shape): ...
class TopoDS_Vertex(TopoDS_Shape): ...

class TopoDS:
    @staticmethod
    def Compound_s(shape: TopoDS_Shape) -> TopoDS_Compound: ...

    @staticmethod
    def Face_s(shape: TopoDS_Shape) -> TopoDS_Face: ...
