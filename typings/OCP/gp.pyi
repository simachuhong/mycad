class gp_Pnt:
    def __init__(self, x: float = 0, y: float = 0, z: float = 0) -> None: ...
    def X(self) -> float: ...
    def Y(self) -> float: ...
    def Z(self) -> float: ...

class gp_Dir:
    def __init__(self, x: float, y: float, z: float) -> None: ...
    def X(self) -> float: ...
    def Y(self) -> float: ...
    def Z(self) -> float: ...

class gp_Ax1:
    def Direction(self) -> gp_Dir: ...
    def Location(self) -> gp_Pnt: ...

class gp_Ax2:
    def __init__(self, point: gp_Pnt, direction: gp_Dir) -> None: ...
    def SetYDirection(self, direction: gp_Dir) -> None: ...

class gp_Cylinder:
    def Axis(self) -> gp_Ax1: ...
    def Radius(self) -> float: ...
